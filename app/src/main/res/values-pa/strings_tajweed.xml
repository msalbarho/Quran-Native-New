<resources>
    <string name="tajweed_guide">ਤਜਵੀਦ ਰੰਗ ਮਾਰਗਦਰਸ਼ਕ</string>
    <string name="tajweed_colors">ਤਜਵੀਦ ਦੇ ਰੰਗ</string>
    <string name="tajweed_rule_1">ਮੱਦ ਲਾਜ਼ਿਮ: ੬ ਹਰਕਤਾਂ</string>
    <string name="tajweed_rule_2">ਮੱਦ ਵਾਜਿਬ ਮੁੱਤਸਿਲ: ੪–੫ ਹਰਕਤਾਂ</string>
    <string name="tajweed_rule_3">ਮੱਦ ਜਾਇਜ਼ ਮੁਨਫ਼ਸਿਲ: ੨, ੪ ਜਾਂ ੫ ਹਰਕਤਾਂ</string>
    <string name="tajweed_rule_4">ਕੁਦਰਤੀ ਮੱਦ / ਇਵਜ਼: ੨ ਹਰਕਤਾਂ</string>
    <string name="tajweed_rule_5">ਇਖ਼ਫ਼ਾ, ਗੁੰਨੇ ਨਾਲ ਇਦਗ਼ਾਮ ਅਤੇ ਗੁੰਨਾ</string>
    <string name="tajweed_rule_6">ਤਫ਼ਖ਼ੀਮ: ਭਾਰੀ ਅੱਖਰ ਅਤੇ ਰਾ</string>
    <string name="tajweed_rule_7">ਕ਼ਲਕ਼ਲਾ</string>
    <string name="tajweed_rule_8">ਨਾ ਪੜ੍ਹੇ ਜਾਣ ਵਾਲੇ ਅੱਖਰ: ਹਮਜ਼ਤੁਲ ਵਸਲ, ਸ਼ਮਸੀ ਲਾਮ ਆਦਿ</string>
