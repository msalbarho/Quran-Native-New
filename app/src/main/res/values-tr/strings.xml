    <string name="guide_reading_title">Okuma</string>
    <string name="guide_reading_body">Sayfalar arasında kaydırın ve bir sureye veya sayfaya gitmek için dizini açın.</string>
    <string name="guide_word_title">Kelime araçları</string>
    <string name="guide_word_body">Dinlemek, tefsiri açmak, yerinizi kaydetmek ve metin, görüntü veya video olarak paylaşmak için herhangi bir Kur’an kelimesine uzun basın.</string>
    <string name="guide_listen_title">Dinleme ve anlamlar</string>
    <string name="guide_listen_body">Bir kari seçip sure veya ayet dinleyin, ardından anlamları seçtiğiniz çeviride okuyun.</string>
