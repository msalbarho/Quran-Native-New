    <string name="tajweed_rule_1">Madd lazim : 6 temps</string>
    <string name="tajweed_rule_2">Madd wajib muttasil : 4–5 temps</string>
    <string name="tajweed_rule_3">Madd jaiz munfasil : 2, 4 ou 5 temps</string>
