    <string name="tajweed_rule_1">لازم مد: ۶ حرکتونه</string>
    <string name="tajweed_rule_2">واجب متصل مد: ۴–۵ حرکتونه</string>
    <string name="tajweed_rule_3">جائز منفصل مد: ۲، ۴ یا ۵ حرکتونه</string>
    <string name="tajweed_rule_4">طبیعي مد / عوض: ۲ حرکتونه</string>
    <string name="tajweed_rule_5">اخفاء، له غنې سره ادغام او د غنې ځایونه</string>
    <string name="tajweed_rule_6">تفخیم: د استعلاء توري او راء</string>
    <string name="tajweed_rule_7">قلقله</string>
    <string name="tajweed_rule_8">نه لوستل کېدونکي توري: وصل همزه، شمسي لام او نور</string>
