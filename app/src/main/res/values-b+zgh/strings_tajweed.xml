    <string name="tajweed_guide">Amnir n yiniyen n tjwid</string>
    <string name="tajweed_colors">Iniyen n tjwid</string>
    <string name="tajweed_rule_1">Madd lazim: 6 n lḥarakat</string>
    <string name="tajweed_rule_2">Madd wajib muttasil: 4–5 n lḥarakat</string>
    <string name="tajweed_rule_3">Madd jaiz munfasil: 2, 4 neɣ 5 n lḥarakat</string>
    <string name="tajweed_rule_4">Madd agaman / iwadh: 2 n lḥarakat</string>
    <string name="tajweed_rule_5">Ikhfa, idgham s ghunna d imukan n ghunna</string>
    <string name="tajweed_rule_6">Tafkhim: isekkilen izuran d ra</string>
    <string name="tajweed_rule_7">Qalqalah</string>
    <string name="tajweed_rule_8">Isekkilen ur ittwanṭaqen: hamzat al-wasl, lam shamsiyya…</string>
